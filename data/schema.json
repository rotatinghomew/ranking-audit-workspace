{
  "format_version": 1,
  "synthetic": true,
  "encoding": "UTF-8",
  "tables": {
    "merchants": {
      "description": "商家经营类型，不预设可疑结论",
      "fields": {
        "id": {
          "type": "string",
          "description": "记录的稳定编号"
        },
        "category": {
          "type": "string",
          "description": "食品类目"
        },
        "channel": {
          "type": "string",
          "description": "经营渠道"
        }
      },
      "references": {}
    },
    "transactions": {
      "description": "合成交易和多渠道登记",
      "fields": {
        "id": {
          "type": "string",
          "description": "记录的稳定编号"
        },
        "family": {
          "type": "string",
          "description": "同一次采购的登记家族"
        },
        "merchant_id": {
          "type": "string",
          "description": "商家"
        },
        "buyer": {
          "type": "string",
          "description": "用途内匿名购买者"
        },
        "buyer_kind": {
          "type": "string",
          "description": "enterprise或household"
        },
        "delivery_group": {
          "type": "string",
          "description": "经授权可用的共同配送点键"
        },
        "ordered_at": {
          "type": "string",
          "description": "实际下单时点"
        },
        "known_at": {
          "type": "string",
          "description": "记录获知时间"
        },
        "units": {
          "type": "number",
          "description": "登记数量"
        },
        "amount_minor": {
          "type": "number",
          "description": "实际金额分"
        },
        "payment_status": {
          "type": "string",
          "description": "paid或cancelled"
        },
        "shipment_proof": {
          "type": "string",
          "description": "documented为有凭据，pending为待取得"
        },
        "duplicate_of": {
          "type": "string",
          "description": "已确认重复的原登记；空串未确认"
        }
      },
      "references": {
        "merchant_id": "merchants"
      }
    },
    "refunds": {
      "description": "后续退款，不删除原交易",
      "fields": {
        "id": {
          "type": "string",
          "description": "记录的稳定编号"
        },
        "transaction_id": {
          "type": "string",
          "description": "原交易"
        },
        "units": {
          "type": "number",
          "description": "实际退货数量"
        },
        "known_at": {
          "type": "string",
          "description": "收到退货资料时间"
        },
        "paid_at": {
          "type": "string",
          "description": "真实退款时点"
        }
      },
      "references": {
        "transaction_id": "transactions"
      }
    },
    "audit_records": {
      "description": "人工审核历史原件，选中方式保留",
      "fields": {
        "id": {
          "type": "string",
          "description": "记录的稳定编号"
        },
        "transaction_id": {
          "type": "string",
          "description": "审查交易"
        },
        "selection": {
          "type": "string",
          "description": "random为概率抽核，targeted为疑点，appeal为主动申诉"
        },
        "probability": {
          "type": "nullable_number",
          "description": "概率抽核实际选中概率"
        },
        "verdict": {
          "type": "string",
          "description": "eligible、ineligible或pending"
        },
        "scope": {
          "type": "string",
          "description": "裁决仅限本交易或明示重复登记"
        },
        "known_at": {
          "type": "string",
          "description": "裁决可知时间"
        },
        "evidence_id": {
          "type": "string",
          "description": "本次实际核对的物流/付款证据键"
        }
      },
      "references": {
        "transaction_id": "transactions"
      }
    },
    "appeals": {
      "description": "商家后续提出的新证据来件",
      "fields": {
        "id": {
          "type": "string",
          "description": "记录的稳定编号"
        },
        "transaction_id": {
          "type": "string",
          "description": "申诉对应交易"
        },
        "submitted_at": {
          "type": "string",
          "description": "实际提交时间"
        },
        "known_at": {
          "type": "string",
          "description": "资料收到时间"
        },
        "new_document": {
          "type": "string",
          "description": "新证明的可审读中文摘要"
        },
        "allowed_reviewers": {
          "type": "array",
          "description": "有权查看的审核人"
        }
      },
      "references": {
        "transaction_id": "transactions"
      }
    },
    "reviewers": {
      "description": "审核资源与证据权限",
      "fields": {
        "id": {
          "type": "string",
          "description": "记录的稳定编号"
        },
        "evidence_rights": {
          "type": "array",
          "description": "可审资料类型"
        },
        "minutes_per_day": {
          "type": "number",
          "description": "每天可用分钟"
        },
        "active_case": {
          "type": "nullable_string",
          "description": "仍在受理的交易"
        },
        "accepted_until": {
          "type": "string",
          "description": "已承诺工作期限"
        }
      },
      "references": {}
    },
    "procurement_adoptions": {
      "description": "采购方基于旧名单发出的邀请和确认",
      "fields": {
        "id": {
          "type": "string",
          "description": "记录的稳定编号"
        },
        "merchant_id": {
          "type": "string",
          "description": "被邀请商家"
        },
        "invitation_at": {
          "type": "string",
          "description": "邀请时间"
        },
        "accepted_at": {
          "type": "nullable_string",
          "description": "实际接受时间"
        },
        "ranking_cutoff": {
          "type": "string",
          "description": "当时名单的事实截止"
        },
        "contract_valid_to": {
          "type": "string",
          "description": "已接受采购约定的结束日"
        }
      },
      "references": {
        "merchant_id": "merchants"
      }
    },
    "policies": {
      "description": "榜单公开采用的资格与稳定性政策",
      "fields": {
        "id": {
          "type": "string",
          "description": "记录的稳定编号"
        },
        "refund_window_days": {
          "type": "number",
          "description": "成熟退款观察天数"
        },
        "minimum_probability_support": {
          "type": "number",
          "description": "总体误计量估计的最小随机支持"
        },
        "max_rank_uncertainty": {
          "type": "number",
          "description": "采购可采用的名次跨度上限"
        },
        "proof_required": {
          "type": "array",
          "description": "正式否决需要的证据类型"
        }
      },
      "references": {}
    }
  }
}
